# Copy to .env for scripts/dev.py; never commit .env or credentials.
SCOUT_MODE=fixture
SCOUT_MODEL_MODE=disabled
SCOUT_STATE_DIR=.scout/fixture
SCOUT_CORE_URL=http://127.0.0.1:8100
SCOUT_API_URL=http://127.0.0.1:8100
SCOUT_OPENALEX_URL=http://127.0.0.1:8111
SCOUT_CROSSREF_URL=http://127.0.0.1:8112
SCOUT_DATACITE_URL=http://127.0.0.1:8113
SCOUT_SEMANTIC_SCHOLAR_URL=http://127.0.0.1:8114
SCOUT_ARXIV_URL=http://127.0.0.1:8115
SCOUT_OPENAIRE_URL=http://127.0.0.1:8116
SCOUT_EUROPE_PMC_URL=http://127.0.0.1:8117
SCOUT_UNPAYWALL_URL=http://127.0.0.1:8118

# Each provider can be enabled independently. Explicit CLI --mode overrides all providers.
SCOUT_OPENALEX_MODE=fixture
SCOUT_CROSSREF_MODE=fixture
SCOUT_DATACITE_MODE=fixture
SCOUT_SEMANTIC_SCHOLAR_MODE=fixture
SCOUT_ARXIV_MODE=fixture
SCOUT_OPENAIRE_MODE=fixture
SCOUT_EUROPE_PMC_MODE=fixture
SCOUT_UNPAYWALL_MODE=fixture

# Hosted upstreams belong to provider services, not the internal URL slots above.
SCOUT_OPENALEX_MCP_URL=https://mcp.openalex.org/mcp
SCOUT_CROSSREF_REST_BASE_URL=https://api.crossref.org
SCOUT_DATACITE_REST_BASE_URL=https://api.datacite.org
SCOUT_SEMANTIC_SCHOLAR_REST_BASE_URL=https://api.semanticscholar.org/graph/v1
SCOUT_ARXIV_REST_BASE_URL=https://export.arxiv.org/api
SCOUT_OPENAIRE_REST_BASE_URL=https://api.openaire.eu/graph/v3
SCOUT_EUROPE_PMC_REST_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
SCOUT_UNPAYWALL_REST_BASE_URL=https://api.unpaywall.org/v2

# Optional live-provider configuration. No live LLM is enabled by these values.
# Obtain/configure your own OAuth grant; an OpenAlex REST key is not an MCP token.
SCOUT_OPENALEX_OAUTH_TOKEN=
SCOUT_OPENALEX_OAUTH_STORE=.scout/credentials/openalex.local.json
SCOUT_SEMANTIC_SCHOLAR_API_KEY=
# Optional public contact email included in the Crossref REST User-Agent (polite client identification).
SCOUT_CONTACT_EMAIL=
# Optional OpenAIRE token; anonymous mode has a lower hourly quota.
SCOUT_OPENAIRE_API_TOKEN=
# Required real contact email for live Unpaywall DOI lookups. Never invent an address.
SCOUT_UNPAYWALL_EMAIL=

# Optional concrete local encoder; installing/configuring one is a separate readiness gate.
SCOUT_SEMANTIC_SCHOLAR_ENCODER_FACTORY=
# Local CPU option after installing requirements-encoder.lock and caching artifacts:
# SCOUT_SEMANTIC_SCHOLAR_ENCODER_FACTORY=research_scout.providers.onnx_encoder:minilm_onnx
SCOUT_SEMANTIC_SCHOLAR_ENCODER_CACHE=.scout/encoder-cache
# Shared local encoder for REST discovery providers; no hosted embeddings or model downloads.
# Set after explicitly caching requirements-encoder.lock artifacts via setup_local_encoder.py.
SCOUT_LOCAL_ENCODER_FACTORY=
SCOUT_LOCAL_ENCODER_CACHE=.scout/encoder-cache

# Optional hosted features. Direct discovery/DOI routing is model-free;
# explicit AI query refinement also uses OpenAI when separately enabled below.
# Only the core receives this key, with generation or retrieval explicitly enabled.
OPENAI_API_KEY=
SCOUT_GENERATION_ENABLED=false
SCOUT_GENERATION_MODEL=gpt-6-luna
SCOUT_GENERATION_MAX_OUTPUT_TOKENS=800
SCOUT_GENERATION_MAX_TURN_COST_USD=0.05
SCOUT_GENERATION_MAX_SESSION_COST_USD=0.25
SCOUT_GENERATION_TIMEOUT_SECONDS=60

# Optional agentic discovery (separate from saved-evidence answer generation).
# Uses OPENAI_API_KEY or a dedicated SCOUT_RETRIEVAL_API_KEY, core process only.
# Maximum two search rounds; up to nine model requests for four automatic providers
# (five for two manual providers), under the shared model ledger/budget.
SCOUT_RETRIEVAL_ENABLED=false
SCOUT_RETRIEVAL_MODEL=gpt-6-luna
