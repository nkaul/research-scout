      "source": "Initial typography search",
      "choice": "Reject literal style recommendations",
      "reason": "Bauhaus/Neubrutalist poster styling is not the requested operational research UI. Keep result in receipt, retry once."
    },
    {
      "source": "Typography retry",
      "choice": [
        "Friendly SaaS",
        "Enterprise SaaS Mobile (Plus Jakarta Sans)"
      ],
      "adaptation": "Use consistent readable role hierarchy and a coherent sans family. Preserve Observatory's locally available Avenir Next/Trebuchet/Segoe UI display character without font downloads. Native uppercase or platform unit advice is not adopted wholesale."
    },
    {
      "source": "Readability UX",
      "choice": [
        "Readable Font Size",
        "Line Height",
        "Color Contrast"
      ],
      "adaptation": "Prefer16px mobile source prose, enforce project review floors, increase metadata/chips/controls explicitly, tune 1.5–1.75 leading and preserve contrast."
    },
    {
      "source": "Targets UX",
      "choice": [
        "Touch Target Size",
        "Target Size (Minimum)",
        "Touch Spacing"
      ],
      "adaptation": "Distinguish web CSS-pixel minimum from native points/dp. Choose40–44px common action targets and8px separation as project usability goals, not a universal conformance assertion."
    },
    {
      "source": "Reflow UX",
      "choice": [
        "Chip Collection Reflow",
        "Text Reflow and Spacing"
      ],
      "adaptation": "Wrap collections, controls and source actions; retain one row of four resource tabs with internally stacked labels/counts. Never solve narrow widths with8–10px text or CSS transform scaling."
    }
  ],
